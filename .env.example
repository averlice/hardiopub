# hardiopub -- example environment (copy to .env and fill in real values)
# All values below are placeholders. NEVER commit your real .env.

# --- Database (MariaDB/MySQL) ---
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=audiopub
DATABASE_USER=audiopub
DATABASE_PASSWORD=CHANGE_ME_DB_PASSWORD

# --- Auth ---
JWT_SECRET=CHANGE_ME_A_LONG_RANDOM_STRING

# --- Backups ---
BACKUP_DIR=backups
BODY_SIZE_LIMIT=104857600

# --- Email (disabled by default: no SMTP server) ---
# Set NO_EMAIL=true to skip the mailgun requirement at startup.
NO_EMAIL=true
# Mailgun (only needed if NO_EMAIL=false):
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=

# --- Push notifications (disabled by default) ---
NO_PUSH_NOTIFICATIONS=true

# --- Streaming (dedicated loopback Icecast) ---
# Point this at YOUR dedicated Icecast instance, not a shared radio server.
ICECAST_HOST=127.0.0.1:8001
ICECAST_ADMIN_USER=admin
ICECAST_ADMIN_PASSWORD=CHANGE_ME_ICECAST_ADMIN_PASSWORD

# --- OneSignal (public static var, may be empty; required at build time) ---
PUBLIC_ONE_SIGNAL_APP_ID=
